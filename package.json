{
    "name": "tradely-accounts",
    "version": "1.2.0",
    "description": "Tradely Accounts - journal, stats, accounts, psychology",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "test:sync": "node tests/profiles.test.js && node tests/account.test.js && node tests/multi.test.js && node tests/pwa.test.js",
        "sql": "node scripts/make-sql-js.js",
        "web": "node scripts/serve.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "electron": "^41.2.1",
        "electron-builder": "^26.8.1",
        "jsdom": "^26.0.0",
        "fake-indexeddb": "^6.0.0"
    },
    "build": {
        "appId": "com.tradely.accounts",
        "productName": "Tradely Accounts",
        "directories": {
            "buildResources": "assets"
        },
        "files": [
            "main.js",
            "titlebar/**/*",
            "app/**/*",
            "assets/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "installerIcon": "assets/icon.ico",
            "uninstallerIcon": "assets/icon.ico"
        }
    }
}